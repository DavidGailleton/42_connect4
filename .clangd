CompileFlags:
  Add:
    - "-xc"
    - "-std=gnu11"
    - "-Wall"
    - "-Wextra"
    - "-Werror"
    - "-I/home/dgaillet/Documents/connect4/inc"
    - "-I/home/dgaillet/Documents/connect4/libft"

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    Add:
      - bugprone-*
      - clang-analyzer-*
      - performance-*
    Remove:
      - bugprone-easily-swappable-parameters
      - bugprone-reserved-identifier
      - clang-analyzer-security.insecureAPI.*

Index:
  Background: Build

Completion:
  AllScopes: false

Hover:
  ShowAKA: false

InlayHints:
  Enabled: false
